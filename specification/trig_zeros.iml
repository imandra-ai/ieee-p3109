(* AI-generated proof that sin and cos can't vanish simultaneously at one chosen
   degree of approximation via a Bezout certificate. Every degree of
   approximation needs a different certificate, so this covers only one very
   special case. *)


(* Proof that the Taylor sections of sin and cos (as defined in
   [Trigonometric]) have no common zeros, at the specification's working
   precision p = 16 (= CERR.approx).

   Note: the corresponding statement for arbitrary p is a hard open problem.
   Since sin' = cos holds exactly at the level of sections (S_p' = C_p for
   equal section index p), a common zero of S_p and C_p is a multiple real
   root of S_p, so the general statement is equivalent to squarefreeness of
   all Taylor sections of sin -- closely related to Szegő's work on the
   zeros of sections of exp. For any fixed p it is decidable; we prove p = 16
   by certificate:

   1. The sections are reflected into coefficient lists over u = x^2:
      sin x p = pevalt (sin_terms 0 p) x x, and likewise for cos
      (theorems [sum_sin_pevalt]/[sum_cos_pevalt], generic in p).
   2. Polynomials over u are reflected into rational coefficient lists with
      evaluator [peval] and ring operations [padd]/[pmul], whose evaluation
      homomorphism theorems are proved by induction.
   3. A Bezout identity A * C + B * S = 1 between the two section polynomials
      (computed offline with gen_trig_cert.py, verified here by ground
      evaluation) then refutes any common zero: 1 = A(u)*0 + B(u)*0 = 0.

   To re-generate the certificate for a different precision, see
   gen_trig_cert.py. *)

[@@@import Util, "dune:math"]
[@@@import Trigonometric, "dune:math"]

open Trigonometric

(* ===== Reflection of the Taylor sections into (sign, factorial) term
   lists, evaluated against the monomials m, m*x^2, m*x^4, ...

   The nonlinear steps are hidden behind [term_val]/[xsq_mul], which are
   disabled in the inductive proofs so that goals close by congruence and
   linear arithmetic alone. *)

(* one Taylor term: sign * (monomial / factorial) *)
let term_val (s : real) (f : real) (m : real) : real = s *. (m /. f)

(* monomial step by x^2 *)
let xsq_mul (x : real) (m : real) : real = m *. (x *. x)

(* evaluate a list of (sign, factorial) terms against monomials m, m*x^2, ... *)
let rec pevalt (cs : (real * real) list) (x : real) (m : real) : real =
  match cs with
  | [] -> 0.0
  | (s, f) :: rest -> term_val s f m +. pevalt rest x (xsq_mul x m)

(* (sign, factorial) term lists of the sin/cos sections, indices k..p *)
let rec sin_terms (k : int) (p : int) : (real * real) list =
  if k > p then []
  else ((-1.0) ^. k, Util.rfactorial (2 * k + 1)) :: sin_terms (k + 1) p
  [@@measure Ordinal.of_int (p - k + 1)]

let rec cos_terms (k : int) (p : int) : (real * real) list =
  if k > p then []
  else ((-1.0) ^. k, Util.rfactorial (2 * k)) :: cos_terms (k + 1) p
  [@@measure Ordinal.of_int (p - k + 1)]

theorem sin_term_tv x k =
  k >= 0 ==>
  sin_term x k
  = term_val ((-1.0) ^. k) (Util.rfactorial (2 * k + 1)) (Util.ripow x (2 * k + 1))
  [@@by auto] [@@rw]

theorem cos_term_tv x k =
  k >= 0 ==>
  cos_term x k
  = term_val ((-1.0) ^. k) (Util.rfactorial (2 * k)) (Util.ripow x (2 * k))
  [@@by auto] [@@rw]

theorem ripow_shift2_tv x k =
  k >= 0 ==> Util.ripow x (2 * k + 3) = xsq_mul x (Util.ripow x (2 * k + 1))
  [@@disable Util.ripow]
  [@@by [%use ripow_succ x (2 * k + 1)] @> [%use ripow_succ x (2 * k + 2)] @> auto]

theorem ripow_shift2_even_tv x k =
  k >= 0 ==> Util.ripow x (2 * k + 2) = xsq_mul x (Util.ripow x (2 * k))
  [@@disable Util.ripow]
  [@@by [%use ripow_succ x (2 * k)] @> [%use ripow_succ x (2 * k + 1)] @> auto]

theorem sin_terms_empty (k : int) (p : int) =
  k > p ==> sin_terms k p = []
  [@@by auto] [@@rw]

theorem cos_terms_empty (k : int) (p : int) =
  k > p ==> cos_terms k p = []
  [@@by auto] [@@rw]

theorem pevalt_nil x (m : real) =
  pevalt [] x m = 0.0
  [@@by auto] [@@rw]

(* The tail sums of the sections agree with their reflections, for any p. *)

theorem sum_sin_pevalt x k p =
  0 <= k && k <= p ==>
  Util.sum (fun i _ -> sin_term x i) k p
  = pevalt (sin_terms k p) x (Util.ripow x (2 * k + 1))
  [@@disable Util.ripow, Util.rfactorial, Trigonometric.sin_term, term_val, xsq_mul]
  [@@by induction ~id:[%id sin_terms] () @>| [
    auto;
    [%use sin_term_tv x k] @> [%use ripow_shift2_tv x k] @> auto;
  ]]

theorem sum_cos_pevalt x k p =
  0 <= k && k <= p ==>
  Util.sum (fun i _ -> cos_term x i) k p
  = pevalt (cos_terms k p) x (Util.ripow x (2 * k))
  [@@disable Util.ripow, Util.rfactorial, Trigonometric.cos_term, term_val, xsq_mul]
  [@@by induction ~id:[%id cos_terms] () @>| [
    auto;
    [%use cos_term_tv x k] @> [%use ripow_shift2_even_tv x k] @> auto;
  ]]

(* ===== Reflection of polynomials over u into rational coefficient lists
   (lowest degree first), with an evaluation homomorphism onto the ring
   operations. *)

let rec peval (cs : real list) (u : real) : real =
  match cs with
  | [] -> 0.0
  | c :: rest -> c +. u *. (peval rest u)

let rec padd (a : real list) (b : real list) : real list =
  match a, b with
  | [], _ -> b
  | _, [] -> a
  | x :: xs, y :: ys -> (x +. y) :: padd xs ys

let rec pscale (c : real) (a : real list) : real list =
  match a with
  | [] -> []
  | x :: xs -> (c *. x) :: pscale c xs

let rec pmul (a : real list) (b : real list) : real list =
  match a with
  | [] -> []
  | x :: xs -> padd (pscale x b) (0.0 :: pmul xs b)

let rec all_zero (cs : real list) : bool =
  match cs with
  | [] -> true
  | c :: rest -> c = 0.0 && all_zero rest

(* the constant-one polynomial, allowing trailing zeros *)
let is_one (cs : real list) : bool =
  match cs with
  | [] -> false
  | c :: rest -> c = 1.0 && all_zero rest

theorem peval_padd a b u =
  peval (padd a b) u = peval a u +. peval b u
  [@@by auto] [@@rw]

theorem peval_pscale c a u =
  peval (pscale c a) u = c *. peval a u
  [@@by auto] [@@rw]

theorem peval_pmul a b u =
  peval (pmul a b) u = peval a u *. peval b u
  [@@by auto] [@@rw]

theorem peval_all_zero cs u =
  all_zero cs ==> peval cs u = 0.0
  [@@by auto] [@@rw]

theorem peval_is_one cs u =
  is_one cs ==> peval cs u = 1.0
  [@@by auto]

(* A Bezout identity a*c + b*s = 1 refutes any common zero of c and s. *)
theorem bezout_refutes a b c s u =
  is_one (padd (pmul a c) (pmul b s)) &&
  peval c u = 0.0 && peval s u = 0.0
  ==> false
  [@@by
    [%use peval_is_one (padd (pmul a c) (pmul b s)) u] @>
    [%use peval_padd (pmul a c) (pmul b s) u] @>
    [%use peval_pmul a c u] @>
    [%use peval_pmul b s u] @>
    auto]

