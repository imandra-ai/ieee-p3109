theorem cert16 () =
  is_one (padd (pmul bezout_a16 cos_coeffs16) (pmul bezout_b16 sin_coeffs16))
  [@@by ground_eval ()]

(* ===== The sections at p = 16, in reflected form. ===== *)

theorem sin16_eval x =
  Trigonometric.sin x 16 = x *. peval sin_coeffs16 (x *. x)
  [@@timeout 600]
  [@@by [%use sum_sin_pevalt x 0 16] @> auto]

theorem cos16_eval x =
  Trigonometric.cos x 16 = peval cos_coeffs16 (x *. x)
  [@@timeout 600]
  [@@by [%use sum_cos_pevalt x 0 16] @> auto]

(* ===== Main result: at the specification precision p = 16 (= CERR.approx),
   the sin and cos sections have no common zeros. ===== *)

theorem sin_cos_never_zero x =
  not (Trigonometric.sin x 16 = 0.0 && Trigonometric.cos x 16 = 0.0)
  [@@disable Trigonometric.sin, Trigonometric.cos]
  [@@by
    [%use sin16_eval x] @>
    [%use cos16_eval x] @>
    [%use cert16 ()] @>
    [%use bezout_refutes bezout_a16 bezout_b16 cos_coeffs16 sin_coeffs16 (x *. x)] @>
    auto]
